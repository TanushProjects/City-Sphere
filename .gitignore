# ──────────────────────────────────────────────
# CitySphere 2.0 — .gitignore
# ──────────────────────────────────────────────

# Environment / Secrets (NEVER commit these)
.env
.env.*
!.env.example
*.local

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnp
.pnp.js

# Build outputs
dist/
dist-ssr/
build/
server/dist/
client/dist/

# TypeScript cache
*.tsbuildinfo

# Logs
logs/
*.log

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# IDE / Editor
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Testing
coverage/
.nyc_output/