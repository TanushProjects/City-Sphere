# ─────────────────────────────────────────────────────────────
# CitySphere 2.0 — Server Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file — it is already in .gitignore.
# ─────────────────────────────────────────────────────────────

# Server
PORT=5001
HOST=0.0.0.0

# MongoDB — local dev default shown; replace with your Atlas URI for production
MONGODB_URI=mongodb://localhost:27017/citysphere

# JWT — generate a strong random string: `openssl rand -base64 48`
JWT_SECRET=REPLACE_WITH_A_STRONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# Google Gemini AI — get your key at https://aistudio.google.com/apikey
GEMINI_API_KEY=REPLACE_WITH_YOUR_GEMINI_API_KEY

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute
